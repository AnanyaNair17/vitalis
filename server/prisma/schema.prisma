// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  DONOR
  HOSPITAL
  ADMIN
}

enum BloodGroup {
  A_POS
  A_NEG
  B_POS
  B_NEG
  AB_POS
  AB_NEG
  O_POS
  O_NEG
}

enum VerificationStatus {
  UNVERIFIED
  VERIFIED
  REJECTED
}

enum RequestStatus {
  OPEN
  CLOSED
}

enum MatchStatus {
  NOTIFIED
  INELIGIBLE
  ACCEPTED
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  passwordHash String
  role         Role
  createdAt    DateTime  @default(now())
  donor        Donor?
  hospital     Hospital?
}

model Donor {
  id                 Int                @id @default(autoincrement())
  userId             Int                @unique
  user               User               @relation(fields: [userId], references: [id])
  name               String
  bloodGroup         BloodGroup
  city               String
  latitude           Float?
  longitude          Float?
  phone              String
  available          Boolean            @default(false)
  verificationStatus VerificationStatus @default(UNVERIFIED)
  declarationAccepted Boolean           @default(false)
  documentKey        String?
  createdAt          DateTime           @default(now())
  matches            RequestMatch[]
}

model Hospital {
  id                 Int                @id @default(autoincrement())
  userId             Int                @unique
  user               User               @relation(fields: [userId], references: [id])
  name               String
  city               String
  contact            String
  verificationStatus VerificationStatus @default(UNVERIFIED)
  createdAt          DateTime           @default(now())
  requests           BloodRequest[]
}

model BloodRequest {
  id         Int            @id @default(autoincrement())
  hospitalId Int
  hospital   Hospital       @relation(fields: [hospitalId], references: [id])
  bloodGroup BloodGroup
  city       String
  urgent     Boolean        @default(false)
  status     RequestStatus  @default(OPEN)
  createdAt  DateTime       @default(now())
  matches    RequestMatch[]
}

model RequestMatch {
  id        Int          @id @default(autoincrement())
  requestId Int
  request   BloodRequest @relation(fields: [requestId], references: [id])
  donorId   Int
  donor     Donor        @relation(fields: [donorId], references: [id])
  status    MatchStatus  @default(NOTIFIED)
  createdAt DateTime     @default(now())

  @@unique([requestId, donorId])
}
